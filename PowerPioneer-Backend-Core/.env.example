# Copy this file to .env (same folder as manage.py) and fill in the values.
# .env is git-ignored; never commit real passwords.

# Required: Supabase -> Project Settings -> Database -> database password
SUPABASE_DB_PASSWORD=

# Shared secret the AI agent sends to POST /api/internal/notify/ (real-time bell). Must match AGENT_INTERNAL_KEY in
# PowerPioneer-AI/langgraph-agent/.env. Both default to the same local-demo value, so it can stay unset locally.
# AGENT_INTERNAL_KEY=

# Optional overrides (defaults point at the team's Supabase project, session pooler)
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres.<project-ref>
# SUPABASE_DB_HOST=aws-1-ap-south-1.pooler.supabase.com
# SUPABASE_DB_PORT=5432
